void printPath(int parent[], int source, int vertex) {
	int path[MAX];
	int count = 0;
	int current = vertex;

	while (current != -1) {
		path[count++] = current;
		if (current == source)
			break;
		current = parent[current];
	}

	for (int i = count - 1; i >= 0; i--) {
		printf("%d", path[i]);
		if (i > 0)
			printf("->");
	}
}

